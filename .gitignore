# Spike: heavy artifacts (models, source videos, renders, intermediate work, build)
# Se conservan en el repo los assets/modelos PEQUEÑOS que el CI necesita para
# ensamblar la app (música, marca, yunet, rnnoise); lo pesado sigue ignorado.
spike/models/*
!spike/models/.gitkeep
!spike/models/*.onnx
!spike/models/*.rnnn
# El alineador (357 MB) NO va al repo: se publica como release y la app lo descarga.
spike/models/mms_fa_int8.onnx
spike/models/mms_fa_fp32.onnx*
spike/models/mms_fa_pre.onnx
spike/assets/*
!spike/assets/brand/
!spike/assets/music/
spike/input/*
!spike/input/.gitkeep
spike/output/*
!spike/output/.gitkeep
spike/work/*
!spike/work/.gitkeep
spike/.venv/
spike/whisper.cpp/
*.mp4
*.mov
*.mkv
*.wav
*.bin
*.gguf
.claude/settings.local.json
desktop/build/
desktop/dist/
spike/bin/
spike/ollama/
spike/logs/

# Reelfy Tauri: motor ensamblado (pesado, por build/CI)
reelfy-desktop/src-tauri/engine/
reelfy-desktop/src-tauri/gen/
