{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reelfy",
  "version": "0.4.0",
  "identifier": "online.mixiuh.reelfy",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "engine/": "engine/"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": "dmg-background.tiff",
        "windowSize": { "width": 660, "height": 460 },
        "appPosition": { "x": 172, "y": 232 },
        "applicationFolderPosition": { "x": 488, "y": 232 }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
