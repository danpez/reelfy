{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reelfy",
  "version": "0.1.0",
  "identifier": "online.mixiuh.reelfy",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Reelfy Studio",
        "width": 1340,
        "height": 940,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0a0c10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
